#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" == refs/heads/main && "${HUTCH_ALLOW_MAIN_PUSH:-0}" != 1 ]]; then
    echo 'Direct pushes to main are blocked. Open a PR (bootstrap only: HUTCH_ALLOW_MAIN_PUSH=1).' >&2
    exit 1
  fi
done
./build.sh --test
